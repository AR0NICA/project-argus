# Copy to a protected local environment file. Do not commit runtime values.
ARGUS_GATEWAY_IMAGE=111111111111.dkr.ecr.ap-northeast-2.amazonaws.com/argus-gateway@sha256:replace_with_digest
ARGUS_WEB_IMAGE=111111111111.dkr.ecr.ap-northeast-2.amazonaws.com/argus-web@sha256:replace_with_digest
ARGUS_WAS_IMAGE=111111111111.dkr.ecr.ap-northeast-2.amazonaws.com/argus-was@sha256:replace_with_digest
AWS_REGION=ap-northeast-2
D1_S3_BUCKET=replace-with-approved-canary-bucket
D1_S3_KEY=scoped/benign-object.txt
D1_S3_OBJECT_VERSION_ID=replace-with-exact-version-id
D1_SSM_SENTINEL_PARAMETER_NAME=/argus/base/d1/sentinel
MYSQL_HOST=replace-with-private-rds-endpoint
MYSQL_DATABASE=argus_synthetic
MYSQL_D1_USER=argus_d1_reader
MYSQL_D1_PASSWORD_FILE=/etc/argus-d1/db-password
