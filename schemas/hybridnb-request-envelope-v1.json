{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argus.local/schema/hybridnb-request-envelope-v1.json",
  "title": "Independent HybridNB request envelope interface (D0 only)",
  "type": "object",
  "required": ["schema_version", "request_id", "run_id", "source", "method", "path", "body_sha256", "evaluation_status"],
  "properties": {
    "schema_version": {"const": "argus.hybridnb-envelope/v1"},
    "request_id": {"type": "string", "maxLength": 128},
    "run_id": {"type": "string", "pattern": "^ARGUS-[0-9]{8}-LOCAL-R[0-9]{2}$"},
    "source": {"const": "original_request"},
    "method": {"type": "string", "maxLength": 8},
    "path": {"type": "string", "maxLength": 256},
    "body_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evaluation_status": {"const": "disabled_not_evaluated"}
  },
  "additionalProperties": false
}
