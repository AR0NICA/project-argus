{
  "manifest_version": "argus.d3-unit.fixture/v1",
  "experiment_group": "R0-UNIT",
  "lab_boundary": "authorized isolated account, approved CIDR, synthetic data only, non-destructive, 1 rps, concurrency 1, <=10 rows, <=32 KiB",
  "safety_bounds": {
    "s01_max_total_requests": 12,
    "per_stage_contract_requests": 1,
    "per_stage_control_requests": 1,
    "max_rps": 1,
    "concurrency": 1,
    "max_result_rows": 10,
    "max_result_bytes": 32768,
    "handoff_ttl_seconds": 120,
    "min_interval_seconds": 1
  },
  "allow_list_actions": ["MARKER", "IMDS_IDENTITY", "WAS_AUTH"],
  "forbidden": [
    "arbitrary SQL text",
    "arbitrary shell or commands",
    "arbitrary URLs",
    "arbitrary file paths",
    "ListBucket, PutObject, DeleteObject, any write or delete API",
    "bucket or IAM policy changes",
    "range scans or internal CIDR enumeration",
    "C2 or reverse shells",
    "credential material capture",
    "non-synthetic data",
    "HybridNB score, label, threshold, or WAF/ML four-quadrant before D5"
  ],
  "hybridnb_boundary": "disabled_not_evaluated before D5; no model score/label/threshold produced",
  "stages": [
    {
      "stage": "S01",
      "fixture_or_resource_id": "ATK-S01-RECON-01",
      "action": null,
      "purpose": "bounded reconnaissance over the frozen public surface only",
      "success_token": "endpoint_map_hash",
      "success_type": "hash",
      "handoff_in": null,
      "handoff_out": "endpoint_contract_id",
      "handoff_out_meaning": "frozen authentication endpoint and request contract",
      "max_requests": 12
    },
    {
      "stage": "S02",
      "fixture_or_resource_id": "ATK-S02-SYNTH-AUTH-01",
      "action": null,
      "purpose": "fixed controlled SQLi-class authentication fixture (no external SQL text accepted)",
      "success_token": "auth_decision_hash",
      "success_type": "hash",
      "handoff_in": "endpoint_contract_id",
      "handoff_out": "auth_decision_id",
      "handoff_out_meaning": "one-time authentication decision id"
    },
    {
      "stage": "S03",
      "fixture_or_resource_id": "ATK-S03-ADMIN-01",
      "action": null,
      "purpose": "issue one administrator session bound to the auth decision",
      "success_token": "admin_session_hash",
      "success_type": "hash",
      "handoff_in": "auth_decision_id",
      "handoff_out": "upload_ticket_id",
      "handoff_out_meaning": "one-time upload ticket id"
    },
    {
      "stage": "S04",
      "fixture_or_resource_id": "ATK-S04-MARKER-01",
      "action": "MARKER",
      "purpose": "administrator-only fixed non-destructive marker write",
